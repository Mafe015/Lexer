
print("Variables y Aritmética ");

val x = 10;
val y = 3;

print(x + y);      // 13
print(x - y);      // 7
print(x * y);      // 30
print(x / y);      // 3.333...
print(x % y);      // 1
print(2 ** 8);     // 256

// Strings
val nombre = "Laura";
val saludo = "Hola, " + nombre + "!";
print(saludo);     // Hola, Laura!

// Flotantes
val pi = 3.14159;
val radio = 5.0;
val area = pi * radio * radio;
print(area);       // ~78.53...



print(" Condicionales ");

val temperatura = 22;

if (temperatura > 30) {
    print("Hace calor");
} elif (temperatura > 20) {
    print("Temperatura agradable");
} elif (temperatura > 10) {
    print("Hace un poco de frio");
} else {
    print("Hace mucho frio");
}

// Operadores lógicos
val tiene_sol = true;
val es_fin_de_semana = false;

if (tiene_sol && !es_fin_de_semana) {
    print("Buen dia laboral con sol");
}

if (tiene_sol || es_fin_de_semana) {
    print("Hay algo bueno hoy");
}



print("Bucle While (contar del 1 al 5) ");

val i = 1;
while (i <= 5) {
    print(i);
    val i = i + 1;
}


